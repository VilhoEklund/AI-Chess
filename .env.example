# Fill these in locally, or set them as Windows environment variables. 
OPENROUTER_API_KEY=sk-or-v1-a1b2c3...

# PREFERRED MODELS:

## For a hard game (very few illegal moves)
# Luna 6 — cheaper ($0.10/m input)
# Gemini 3.8 Flash — faster (2–3 s)

## For a quick game (illegal moves, occasional blunders)
# Luna 5.6 — fastest (1 s), most fun gimmick
# DeepSeek v4.1 Flash — fewer illegal moves (3 s), cheapest ($0.04/m input)

## Benchmark — fastest profile (15 s max thinking)
#
# | Model               | Response time | Price / 1M in | Price / 1M out |
# | ------------------- | ------------: | ------------: | --------------: |
# | Luna 5.6            |          ~1 s |        $0.20  |          $1.20  |
# | DeepSeek v4.1 Flash |          ~3 s |        $0.04  |          $1.00  |
# | Gemini 3.8 Flash    |       2–3 s   |        $0.75  |          $3.75  |
# | Luna 6              |      5–10 s   |        $0.10  |          $0.50  |

## Best overall — Luna 5.6 ★
# Very fast, still makes some illegal moves (but not too many).
# Games cost roughly 1 cent.

OPENROUTER_MODEL=google/gemini-3.8-flash

# Optional reasoning allowance at 30 seconds. Time profiles cap its scaling;
# increasing this cannot override their limits. Luna and DeepSeek use effort controls.
OPENROUTER_REASONING_TOKENS=1500
