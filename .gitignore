# Everything lives inside AIChess/ — these folder-agnostic patterns cover
# it from here too, in case "git add ." is ever run at this outer level.

# Dependencies — never commit; reinstall with: npm install
node_modules/

# Secrets — never commit (key lives in Windows env vars)
.env

# Build output — regenerable with: npm run build
dist/

# Claude Code local session data
.claude/