# Patterns without a leading slash match at EVERY depth inside this
# project folder — so one file here covers everything.

# Dependencies — never commit; reinstall anytime with: npm install
node_modules/

# Build output — regenerable with: npm run build
dist/

# Secrets/config — must NEVER be added, even by "git add ." .
# The OpenRouter key lives ONLY in Windows env vars; .env holds no key.
.env